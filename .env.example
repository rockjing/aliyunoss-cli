# 阿里云OSS配置（必需）
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET=your_bucket_name
OSS_REGION=oss-cn-beijing

# 阿里云OSS可选配置
OSS_SECURE=true
OSS_TIMEOUT=300
OSS_INTERNAL=false
OSS_CNAME=
OSS_IS_REQUEST_PAY=false
OSS_STS_TOKEN=

# MCP服务器配置
MCP_LOG_LEVEL=info
MCP_LOG_FORMAT=json
MCP_MAX_FILE_SIZE=100
MULTIPART_THRESHOLD=10
MULTIPART_PART_SIZE=5
MULTIPART_CONCURRENCY=3

# 应用环境配置
NODE_ENV=production
DEBUG=false
VERBOSE=false

# 文件过期配置
FILE_EXPIRY_HOURS=1